# TechStore world model — copy to data/company/company.yaml
# Canonical constants for the generator, policy engine, and policy docs.

company:
  name: TechStore
  industry: electronics_ecommerce
  country: Brazil
  locale: pt_BR
  currency: BRL
  timezone: America/Sao_Paulo
  channels:
    - web
  support: web_only

simulation:
  # frozen: use simulation.now (CI/evals). wall_clock: datetime.now(tz) on each run.
  clock: frozen
  # Anchor when clock=frozen (or when neither --as-of nor wall_clock is used).
  now: "2026-08-14T12:00:00-03:00"
  seed: 42

customer_tiers:
  - standard
  - silver
  - gold
  - enterprise

account_statuses:
  - active
  - suspended
  - closed

support:
  hours:
    start: "08:00"
    end: "20:00"
  timezone: America/Sao_Paulo

refund:
  standard_window_days: 30
  approval_threshold_brl: 1000
  restocking_fee_rate: 0.10
  original_payment_method_only: true
  identity_verification_required: true

warranty:
  default_days: 90
  computers_days: 365
  smartphones_days: 365
  electronics_inspection_after_days: 7

shipping:
  carriers:
    - Correios
    - Jadlog
  delivery_methods:
    express_sedex:
      label_pt: "Rápida Sedex (até 3 dias úteis)"
      business_days: 3
    standard:
      label_pt: "Entrega padrão (até 7 dias úteis)"
      business_days: 7

cancellation:
  allowed_before_shipment: true
  shipped_requires_return_flow: true

# Customer-facing labels for enums (DB stores English snake_case keys)
labels:
  payment_status:
    pending_confirmation: "Em processo de confirmação de pagamento"
    confirmed: "Pagamento confirmado"
    declined: "Pagamento recusado"
    refunded: "Reembolsado"
    partially_refunded: "Parcialmente reembolsado"
  order_status:
    picking: "Em separação"
    picked: "Pedido separado"
    posted: "Pedido postado"
    in_transit: "Pedido em rota de entrega"
    out_for_delivery: "Pedido saiu para o destinatário"
    delivered: "Pedido entregue"
    cancelled: "Pedido cancelado"
    returned: "Pedido devolvido"
  delivery_method:
    express_sedex: "Rápida Sedex (até 3 dias úteis)"
    standard: "Entrega padrão (até 7 dias úteis)"

# Price bands (BRL) — unit_price = seeded draw per SKU within band
price_bands:
  hardware: { min: 199.90, max: 4999.90 }
  peripherals: { min: 49.90, max: 899.90 }
  computers: { min: 2499.90, max: 18999.90 }
  games_consoles: { min: 299.90, max: 5999.90 }
  smartphones: { min: 699.90, max: 8999.90 }
  monitors_displays: { min: 599.90, max: 4999.90 }
  tvs: { min: 999.90, max: 12999.90 }
  audio: { min: 79.90, max: 2999.90 }
  projectors: { min: 499.90, max: 7999.90 }
  tablets_ereaders: { min: 399.90, max: 9999.90 }
  cameras_drones: { min: 299.90, max: 8999.90 }
  connectivity: { min: 59.90, max: 1999.90 }
  power: { min: 39.90, max: 2999.90 }
  smart_home: { min: 49.90, max: 1499.90 }
  security: { min: 99.90, max: 3999.90 }
  gaming_space: { min: 149.90, max: 2999.90 }
  office: { min: 89.90, max: 3999.90 }
  automation_robotics: { min: 79.90, max: 2499.90 }

catalog:
  source: data/company/product_catalog.yaml
  naming: generic_no_trademarks
  categories:
    - hardware
    - peripherals
    - computers
    - games_consoles
    - smartphones
    - monitors_displays
    - tvs
    - audio
    - projectors
    - tablets_ereaders
    - cameras_drones
    - connectivity
    - power
    - smart_home
    - security
    - gaming_space
    - office
    - automation_robotics
