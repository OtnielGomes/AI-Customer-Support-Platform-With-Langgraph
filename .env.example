# Application
APP_NAME=ai-customer-support
APP_ENV=development
LOG_LEVEL=INFO

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/support

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# API authentication (comma-separated keys with optional scopes: key:scope1,scope2)
# Example: dev-key:read,write,billing:write
API_KEYS=dev-key:read,write,billing:write

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-customer-support

# Supervisor thresholds
SUPERVISOR_CONFIDENCE_THRESHOLD=0.7
