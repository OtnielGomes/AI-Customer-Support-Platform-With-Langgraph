# Application
APP_NAME=ai-customer-support
APP_ENV=development
LOG_LEVEL=INFO

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/support

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# API authentication (semicolon-separated keys; scopes after first colon, comma-separated)
# Example: dev-key:read,write,billing:write
# Multiple keys: dev-key:read,write;billing-bot:billing:write
API_KEYS=dev-key:read,write,billing:write

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-customer-support

# Supervisor thresholds
SUPERVISOR_CONFIDENCE_THRESHOLD=0.7

# Live chat SSE heartbeat
CHAT_STREAM_HEARTBEAT_SECONDS=15

# Portal must never create customers for unknown emails
PORTAL_ALLOW_UNKNOWN_EMAIL=0

# Opt-in RAG corpus for indirect prompt-injection evals (keep 0 in normal bootstrap)
INCLUDE_INJECTION_CORPUS=0

# Optional CORS (comma-separated). Leave empty when the Next.js BFF proxies the API.
CORS_ORIGINS=
